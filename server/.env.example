# =========================================================================
# OverDuty Pro - Server Environment Configuration Template
# Keep this file as an example. NEVER commit real secrets to GitHub!
# =========================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Primary MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/over_duty_db?retryWrites=true&w=majority

# Optional Secondary / Backup MongoDB Atlas Cluster (Auto-Sync & Instant Failover)
# Connects to an independent MongoDB account/cluster for 100% real-time data mirroring
MONGODB_SECONDARY_URI=mongodb+srv://<backup_db_user>:<backup_db_pass>@cluster-backup.xxxxx.mongodb.net/over_duty_db?retryWrites=true&w=majority

# JWT Token Secret & Lifetime
JWT_SECRET=your_super_strong_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=https://roni-sardar.vercel.app

# Resend API Key for Automated Email Backups & 2FA OTP
RESEND_API_KEY=re_your_resend_api_key_here
